# PhishShield environment configuration (EXAMPLE)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to version control.

# Flask secret key used to sign sessions. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Application environment: development | production | testing
FLASK_ENV=development

# Database URI (defaults to a local SQLite file inside instance/)
# DATABASE_URL=sqlite:///phishshield.db

# ---- DEMO SEED CREDENTIALS (development only) ----
# These are used ONLY by scripts/seed_demo_data.py to create demo accounts.
# They are intentionally NOT hardcoded in application source.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@phishshield.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_USERNAME=student
SEED_USER_EMAIL=student@phishshield.test
SEED_USER_PASSWORD=Student@12345

# Redirect checking is DISABLED by default for safety. Do not enable in a shared
# environment. When true, only allowlisted hosts are contacted (see config.py).
ENABLE_REDIRECT_CHECK=false
